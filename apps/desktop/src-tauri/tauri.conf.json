{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Redoc",
  "version": "0.1.0",
  "identifier": "com.redoc.desktop",
  "mainBinaryName": "redoc-desktop-tauri",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Redoc",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      },
      {
        "label": "presenter",
        "title": "Redoc — Presenter",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["redoc"],
        "name": "Redoc Document",
        "description": "Redoc office document",
        "role": "Editor",
        "mimeType": "application/x-redoc"
      }
    ]
  }
}
