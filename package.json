{
  "name": "redoc-monorepo",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --filter @redoc/desktop dev",
    "build": "pnpm --filter @redoc/desktop build",
    "generate:bindings": "cargo run -p redoc-desktop-tauri --bin generate-bindings",
    "create:updater-config": "node scripts/create-updater-config.mjs",
    "tauri": "pnpm --filter @redoc/desktop exec tauri",
    "tauri:dev": "pnpm --filter @redoc/desktop exec tauri dev",
    "tauri:build": "pnpm --filter @redoc/desktop exec tauri build",
    "test": "vitest run && cargo test --workspace",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "a11y:check": "vitest run --config vitest.a11y.config.ts",
    "performance:check": "node scripts/perf-budget.mjs",
    "typecheck": "pnpm exec tsc -p apps/desktop/tsconfig.json --noEmit",
    "lint": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings",
    "quality:check": "node scripts/quality-gates.mjs",
    "ledger:check": "node scripts/validate-capability-ledger.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tauri-apps/cli": "^2.1.0",
    "@vitest/coverage-v8": "^2.1.4",
    "axe-core": "^4.12.1",
    "jsdom": "^30.0.1",
    "solid-js": "^1.9.14",
    "typescript": "^7.0.2",
    "vite": "^5.4.10",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^2.1.4"
  }
}
